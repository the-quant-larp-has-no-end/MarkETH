# What the deployed stack sets differently from .example.env (SPEC A.10).
#
# `make deploy-env` renders the VM's .env on the VM: .example.env, then this file, then
# the VM's own file with the two Postgres passwords and the bootstrap admins
# (backend/scripts/production_env.py). Every key here must exist in .example.env.
# No secret and no admin belongs in this file; it is committed.
#
# The name does not end in ".env" on purpose: .gitignore ignores "*.env".

APP_ENV=production

# The team's address behind the VIScon portal (docs/SERVER_INFRASTRUCTURE.md §1). It is
# the only origin a state-changing request may come from.
PUBLIC_BASE_URL=https://09.hackathon.ethz.ch
ALLOWED_ORIGINS=https://09.hackathon.ethz.ch

# The portal's sign-in offers every Swiss university; an account here is an id at this
# domain, taken exactly as the portal sends it (docs/SERVER_INFRASTRUCTURE.md §3.3).
ALLOWED_EMAIL_DOMAINS=ethz.ch

# Every interface of the VM, stated here because .example.env publishes on the loopback
# interface alone. The portal connects on the private interface. On the public one the
# VM's firewall is all that keeps the port closed, and whoever reaches the port can act
# as anyone: an accepted risk (docs/SERVER_INFRASTRUCTURE.md §13, check 7), which
# `make deploy-check` probes from outside at every deploy.
NGINX_HTTP_BIND=0.0.0.0

# The built server. .example.env sizes the container for `next dev`.
WEB_MEMORY_LIMIT=512m

# The development value without 'unsafe-eval' and without WebSocket sources: the built
# app needs neither. Inline scripts stay allowed because the app router emits them and a
# header set by the proxy cannot carry a nonce.
NGINX_CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

# Nobody is named by the stack itself: who is calling is what the portal says.
# compose.override.yaml, which reads these two, refuses to start with them empty.
DEV_USER_ID=
DEV_USER_NAME=

# Where this stack lives: the SSH host and the directory under its home directory.
DEPLOY_SSH_HOST=viscon-2026
DEPLOY_PATH=marketh
