# MarkETH reverse proxy (SPEC §9): one origin for the Next.js app and the API, so the
# session cookie needs no CORS.
#
# The nginx image renders this template with envsubst at start-up and writes the result
# to /etc/nginx/conf.d/default.conf, inside the http block. compose.yaml sets
# NGINX_ENVSUBST_FILTER=^NGINX_, so only placeholders named NGINX_* are replaced and
# nginx's own $variables are left alone. The values come from the Nginx section of .env.

# Docker's embedded DNS. The upstreams below are named through variables, which makes
# nginx resolve them per request instead of once at start-up: it starts before api and
# web exist and follows them to a new address when they restart.
resolver 127.0.0.11 valid=5s ipv6=off;

# Client address. Only a peer on a private network may speak for a client: that is the
# HTTPS tunnel of a phone demo (A.10), which reaches the published port through Docker's
# gateway and names the phone in X-Forwarded-For. Everything below, including the rate
# limit and the address handed to the API, then uses the phone's address.
set_real_ip_from 127.0.0.0/8;
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from fc00::/7;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Scheme the browser used. nginx itself speaks plain HTTP; a TLS-terminating tunnel in
# front says so in X-Forwarded-Proto, and that value is passed on.
map $http_x_forwarded_proto $client_scheme {
    default $scheme;
    https   https;
}

# HSTS only for requests that arrived over TLS. An empty value sends no header.
map $client_scheme $hsts {
    default "";
    https   "max-age=31536000";
}

# The Next.js dev server pushes hot reloads over a WebSocket, the only upgrade let
# through. Every other request goes upstream without a Connection header at all, which
# is what server-sent events need.
map $http_upgrade $connection_upgrade {
    default   "";
    websocket upgrade;
}

# Second layer behind the API's own Redis limits (SPEC §9).
limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=${NGINX_RATE_LIMIT};
limit_req_status 429;

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/json application/javascript application/manifest+json
               image/svg+xml text/css text/javascript text/plain text/x-component;

    # nginx inherits add_header and proxy_set_header only into a location that sets none
    # of its own, so they are all set here and no location below adds one.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "${NGINX_CONTENT_SECURITY_POLICY}" always;
    add_header Strict-Transport-Security $hsts always;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $client_scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    set $web_upstream web:3000;
    set $api_upstream api:8000;

    location / {
        proxy_pass http://$web_upstream;
    }

    # The dev server's hot-reload WebSocket lives under /_next/ and says nothing between
    # edits. It gets the patience of the event stream; the default 60 s would drop it
    # once a minute.
    location /_next/ {
        proxy_read_timeout ${NGINX_SSE_READ_TIMEOUT};
        proxy_pass http://$web_upstream;
    }

    location /api/ {
        limit_req zone=api_per_ip burst=${NGINX_RATE_LIMIT_BURST} nodelay;
        error_page 429 = @api_rate_limited;
        error_page 502 504 = @api_unavailable;
        proxy_pass http://$api_upstream;
    }

    # Server-sent events: unbuffered, long-lived and outside the rate limit. A regex
    # location wins over the /api/ prefix above.
    location ~ ^/api/markets/[^/]+/stream$ {
        proxy_buffering off;
        proxy_read_timeout ${NGINX_SSE_READ_TIMEOUT};
        error_page 502 504 = @api_unavailable;
        proxy_pass http://$api_upstream;
    }

    # What nginx itself answers on /api/ keeps the API's error shape (A.2).
    location @api_rate_limited {
        default_type application/json;
        return 429 '{"code":"RATE_LIMITED","message":"Too many attempts. Try again later.","details":{"retry_after_seconds":1}}';
    }

    location @api_unavailable {
        default_type application/json;
        return 503 '{"code":"SERVICE_UNAVAILABLE","message":"This is temporarily unavailable. Try again shortly.","details":{}}';
    }
}
