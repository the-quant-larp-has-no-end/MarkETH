# MarkETH environment.
#
# Every tunable of the system lives in this file and nowhere else: the backend's Settings
# (backend/app/core/config.py) has no defaults, so a missing variable fails startup.
# Copy this file to `.env` (gitignored). Compose injects it into the containers as real
# environment variables; processes started on the host read the same file.
#
# Conventions
#   - Amounts are in CR (1 CR = 1 credit = 1,000,000 µCR; on screen a credit is a token).
#     The code converts to µCR.
#   - "§N" refers to docs/SPEC.md. Names used by the spec are kept verbatim.
#   - Lists are comma-separated, with no space around the commas.
#   - *_HOST / *_PORT describe where a process on the host finds a service; the dev stack
#     publishes each store on that port. Inside compose both are overridden with the
#     service name and its standard port (see compose.yaml).

# --- General ---------------------------------------------------------------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Calendar used for monthly grants, issuance caps and proposal limits (§2).
APP_TIMEZONE=Europe/Zurich
# Public origin of the app. Used in the QR links of code cards (A.6).
PUBLIC_BASE_URL=http://localhost:8080
# Origins allowed on state-changing requests (A.2). Must include PUBLIC_BASE_URL.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# --- Published ports (compose only) ----------------------------------------
# The one port of the stack is nginx: the interface and the port it is published on.
# 127.0.0.1 is this machine alone. The development proxy names a caller to whoever
# reaches it (see "Local identity" below), so it is not offered to the network. The
# deployed stack sets 0.0.0.0, every interface of the host (infra/deploy/env.production).
NGINX_HTTP_BIND=127.0.0.1
NGINX_HTTP_PORT=8080
# Development overlay only, always on the loopback interface.
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# --- Networks (compose only) -------------------------------------------------
# The network between the proxy and the web app: its address range, and the address
# of Docker's own gateway on it. The web app is the only other peer of that network.
EDGE_SUBNET=192.168.209.0/28
EDGE_GATEWAY=192.168.209.1

# --- Container resources (compose only) --------------------------------------
# Hard memory limit per container. The VM has 7.6 GiB and no swap.
NGINX_MEMORY_LIMIT=128m
# Sized for `next dev`; the built server needs far less.
WEB_MEMORY_LIMIT=2g
API_MEMORY_LIMIT=768m
# relay, and migrate while it runs.
BACKEND_WORKER_MEMORY_LIMIT=256m
POSTGRES_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=128m
# The container around ScyllaDB. SCYLLA_MEMORY (below) is what ScyllaDB itself uses,
# and ScyllaDB sets another 1.5 GiB of the container aside for everything around it:
# this limit has to be more than the two together, or ScyllaDB refuses to start.
SCYLLA_MEMORY_LIMIT=4g
# Docker keeps this much output per container: files of this size, this many.
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=3
# How long a stop of the api container waits for requests in flight before it ends
# them. An open event stream never ends by itself: without this limit every restart
# would last until Docker kills the process.
API_SHUTDOWN_TIMEOUT_SECONDS=5
# Files a container may hold open at once. An open event stream is a socket of the api
# and two connections of nginx; a viewer of a live stream is two connections of nginx.
API_NOFILE_LIMIT=4096
NGINX_NOFILE_LIMIT=8192
# The media box, which turns what a broadcaster sends into the live stream people watch.
# One transcode takes about one CPU and 256 MiB.
MEDIA_MEMORY_LIMIT=512m
MEDIA_CPUS=1.5
MEDIA_PIDS_LIMIT=128
# The memory disk that holds the playlist and the segments of every running live stream.
MEDIA_HLS_TMPFS_SIZE=64m

# --- Postgres (§7): the only source of truth -------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketh
# Owner role: runs migrations only.
POSTGRES_USER=marketh_owner
POSTGRES_PASSWORD=marketh_owner_dev
# App role: used by api and relay. Has no UPDATE/DELETE on the ledger tables (§7).
POSTGRES_APP_USER=marketh_app
POSTGRES_APP_PASSWORD=marketh_app_dev
# Connections the api keeps to Postgres, and how many more it opens when all are in use.
# A full room's reads are served from kept connections, so none is opened on top.
POSTGRES_POOL_SIZE=30
POSTGRES_MAX_OVERFLOW=0
# How long a request waits for a connection while every one of the pool is in use.
# After that the API answers 503, so the client sends the request again (§9).
POSTGRES_POOL_TIMEOUT_SECONDS=10
# How long a statement of the api or the relay waits for a lock another transaction
# holds. After that it fails and the API answers 503, so the client sends the request
# again (§8, §9).
POSTGRES_LOCK_TIMEOUT_MS=5000

# --- Redis (§9): limits, cache, live quotes ---------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Socket timeout. Kept short so a dead Redis never slows a trade down.
REDIS_TIMEOUT_MS=250
# How long a market list is served from the cache (§9: 5 seconds).
MARKET_CACHE_TTL_SECONDS=5

# --- Live values (§9): what the API pushes to an open tab -------------------
# Seconds between two beats of an open event stream. A beat keeps proxies from closing
# an idle stream, and a tab that misses two of them calls its stream lost.
SSE_HEARTBEAT_SECONDS=15
# Event streams one API process holds open at once. One more is answered 503.
LIVE_MAX_STREAMS=200
# Seconds an event stream lasts at most: the API ends each after 80% to 100% of them,
# and the tab opens one again through the portal. Above twice SSE_HEARTBEAT_SECONDS.
LIVE_STREAM_MAX_SECONDS=900
# Milliseconds a tab waits before it opens a stream again that ended: each stream is
# told a wait between this and twice this.
LIVE_RETRY_MS=2000
# Topics one stream may name: 1 to 32.
LIVE_TOPICS_PER_STREAM=8
# Events a stream may be behind. A stream that falls further back is ended.
LIVE_QUEUE_EVENTS=256
# Bytes of the largest event. At least 512, and at least 4 x CHAT_MESSAGE_MAX_LENGTH + 512,
# so that the longest chat message fits one event.
LIVE_EVENT_MAX_BYTES=4096
# Seconds between two announcements that the leaderboard moved.
LEADERBOARD_REFRESH_SECONDS=5

# --- ScyllaDB (§9): price history ------------------------------------------
SCYLLA_HOSTS=localhost
SCYLLA_PORT=9042
SCYLLA_KEYSPACE=marketh
SCYLLA_REPLICATION_FACTOR=1
# How long one statement may take. The read of a chart asks day by day, one statement
# each, and gets the same time as a whole; after that the chart is read from Postgres.
SCYLLA_REQUEST_TIMEOUT_MS=1000
# Container resources (compose only).
SCYLLA_SMP=1
SCYLLA_MEMORY=2G
# Outbox relay: rows per batch (§9: up to 100) and idle poll interval.
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=500
# The chart of a market. Neither store is asked for more than HISTORY_READ_LIMIT
# points, the newest ones, and what was read is thinned evenly to HISTORY_MAX_POINTS,
# keeping its first and its latest point. 2 <= HISTORY_MAX_POINTS <= HISTORY_READ_LIMIT.
HISTORY_MAX_POINTS=500
HISTORY_READ_LIMIT=5000

# --- Identity and eligibility (§3) -----------------------------------------
# Request headers in which the portal names the signed-in person. The API has no
# sign-in of its own and trusts them because only the portal can reach it.
IDENTITY_HEADER_USER_ID=X-User-Id
IDENTITY_HEADER_USER_NAME=X-User-Name
# An id is accepted when, in lower case, it is exactly an address at one of these
# domains: [a-z0-9][a-z0-9._-]{0,63}@<domain>. An id is an account: the same name at
# two domains would be two accounts.
ALLOWED_EMAIL_DOMAINS=ethz.ch
# The bootstrap admins. A role is kept with the account: everybody starts as a plain
# user, and an admin gives and takes roles in the admin panel. An address listed here
# is an admin whatever its account says, also before it has a profile, and the panel
# can neither change its role nor suspend it. Each entry is an id, read by the rule
# above; one that the rule refuses fails startup.
ADMIN_EMAILS=admin@ethz.ch
# A username is made of lower-case letters, digits and underscore, at most 32 of them.
# These two are the lengths a person may choose.
USERNAME_MIN_LENGTH=3
USERNAME_MAX_LENGTH=20
# Usernames nobody can take, so that no account passes for an official one.
RESERVED_USERNAMES=admin,administrator,vis,viscon,vseth,eth,ethz,marketh,moderator,support,staff,barista,system,official
# How often, per user and API process, a request books that user's owed monthly grants
# and refunds their expired vouchers (A.3).
UPKEEP_INTERVAL_SECONDS=60
# Days a person waits between two changes of the degree programme in their profile:
# 0 to 365. The first change is free. 0: a programme changes as often as its owner likes.
PROGRAMME_CHANGE_COOLDOWN_DAYS=30

# --- Grants (§2): free credits by rule --------------------------------------
# CR a person gets once, with their profile.
SIGNUP_GRANT_CR=500
# CR every active user gets once a month, on the day of the month and at the time of
# day they signed up (on the last day of a month that has no such day).
MONTHLY_GRANT_CR=200

# --- Streaks and badges -----------------------------------------------------
# A day counts for a player's streak when they make at least one trade on it (a
# calendar day of APP_TIMEZONE). CR booked for every day that counts, the first day of
# a streak included. 0 books nothing; the days are counted all the same.
STREAK_DAILY_REWARD_CR=2
# days:CR. A bonus, booked once per player: the first time their streak is that many
# days long. Days are whole numbers from 2 to 9999, ascending; a bonus is above zero.
# Empty for no bonus.
STREAK_MILESTONES=7:10,30:50,100:200
# Milliseconds the streak step of a trade waits for a lock another transaction holds.
# After that the trade commits without the step. Above zero, and at most
# POSTGRES_LOCK_TIMEOUT_MS.
STREAK_LOCK_TIMEOUT_MS=250
# Name:wins. A player's badge is the last entry whose wins they have reached. A win is
# a resolved market that returned more than the player put in, as the leaderboard
# counts it. The first entry starts at 0, so every player has a badge; wins ascend.
BADGE_LEVELS="Rookie:0,Forecaster:1,Analyst:5,Strategist:15,Oracle:40"

# --- Codes (§2): free credits by code ---------------------------------------
# Characters of Crockford Base32 (12 = 60 bits).
CODE_LENGTH=12
# CR a code may be worth, from MIN to MAX, and what it is worth when a batch names no
# value. MIN <= DEFAULT <= MAX.
CODE_MIN_VALUE_CR=5
CODE_MAX_VALUE_CR=500
CODE_DEFAULT_VALUE_CR=35
# CR of code value VIS may issue per calendar month.
MAX_CODE_ISSUANCE_PER_MONTH=7000
# Attempts one user may make per window. Redemption fails closed (503) if Redis is down.
CODE_REDEEM_LIMIT_PER_USER=5
CODE_REDEEM_LIMIT_PER_USER_WINDOW_SECONDS=600

# --- Vouchers (§2): what credits buy ----------------------------------------
# Name:price in CR, in the order the wallet lists them. A product's id is the slug of
# its name ("Iced Tea" is iced-tea). An issued voucher keeps the name and the price it
# was issued with.
VOUCHER_PRODUCTS="Coffee:35,Mate:35,Softdrinks:35,Redbull:35,Iced Tea:35,Tea:30,Twix:15,Snickers:15,M&Ms:15,Chewing Gum:20,Toblerone:5"
# Characters of the code a barista scans or types (Crockford Base32).
VOUCHER_CODE_LENGTH=8
# An unused voucher is refunded after this many days.
VOUCHER_EXPIRY_DAYS=30
# The barista who redeemed a voucher is shown that redemption again when they scan
# the voucher once more within this many seconds: the answer to a scan can get lost on
# the way. Nothing is booked for it. Anybody else, or later, is told the code is not
# valid.
VOUCHER_RESCAN_SECONDS=120

# --- LMSR pricing and trading (§4) ------------------------------------------
# Liquidity parameter b per tier, in CR. Worst-case loss per market is b * ln 2.
LMSR_TIER_TIGHT_B=500
LMSR_TIER_DEFAULT_B=1000
LMSR_TIER_MEDIUM_B=2000
PRICING_DECIMAL_PRECISION=50
# CR a user may have at stake per market.
MAX_STAKE_PER_USER_MARKET=100
# Smallest trade: in CR when it is sized by amount, in shares when it is sized by shares.
MIN_TRADE_CR=1
MIN_TRADE_SHARES=1
# Shortcuts of a buy on the trade sheet, in shares: one to four whole numbers above
# zero, ascending.
TRADE_SHARE_PRESETS=10,50,100
# Shares between two positions of the slider on the trade sheet: a whole number above
# zero. The slider of an outcome runs from the smallest multiple of it that is a trade
# (MIN_TRADE_SHARES) to the largest whose cost the stake left and the balance both cover.
TRADE_SHARE_STEP=1
# Buy buttons offered on the trade sheet.
TRADE_STAKE_PRESETS_CR=25,50,100
# CR between two positions of the slider on the trade sheet: a whole number above zero.
# The slider runs from the smallest multiple of it that is a trade (MIN_TRADE_CR) to the
# largest that the stake left and the balance both cover.
TRADE_STAKE_STEP_CR=1
# Decimals of a displayed percentage (1 = 0.1 percentage points).
PRICE_DISPLAY_DECIMALS=1

# --- Risk controls (§5) -----------------------------------------------------
MAX_OPEN_MARKETS=100
# CR. b is derived from the budget: b = budget / ln 2. PRICING_DECIMAL_PRECISION=50
# prices budgets up to 69,314 CR.
MAX_MARKET_BUDGET=5000
# CR. Sum of b * ln 2 over OPEN and HALTED markets.
MAX_AGGREGATE_LOSS_BUDGET=70000
# Trades per user per minute.
MAX_ORDERS_PER_MINUTE=10
# Days between approval and close_at.
MAX_MARKET_LIFETIME=90
# The admin risk page shows a warning above this many CR of outstanding obligations (A.6).
OBLIGATIONS_ALERT_THRESHOLD_CR=100000
# CR an admin may add to one user's balance with one adjustment. What an adjustment
# takes away is bounded by the balance.
MAX_ADMIN_ADJUSTMENT_CR=1000

# --- Market lifecycle (§6) --------------------------------------------------
MAX_PROPOSALS_PER_USER_PER_DAY=3
# resolve_by may be at most this many days after close_at.
MAX_RESOLUTION_DELAY_DAYS=14

# --- Discussion (§6): questions and answers of a market ---------------------
# Characters of a question, from MIN to MAX (at most 500), and of an answer (at most 2000).
DISCUSSION_QUESTION_MIN_LENGTH=10
DISCUSSION_QUESTION_MAX_LENGTH=300
DISCUSSION_ANSWER_MAX_LENGTH=1000
# Questions one market holds that are not removed, answered and waiting together.
DISCUSSION_MAX_QUESTIONS_PER_MARKET=100
# Questions of one user that wait for an answer in one market. Not above
# DISCUSSION_MAX_QUESTIONS_PER_MARKET.
DISCUSSION_MAX_WAITING_PER_USER=3
# Questions one user may ask per window, over every market.
DISCUSSION_QUESTION_LIMIT_PER_USER=5
DISCUSSION_QUESTION_LIMIT_PER_USER_WINDOW_SECONDS=600

# --- Live chat (§6): beside a market's live stream --------------------------
# Characters of a message: at most 500.
CHAT_MESSAGE_MAX_LENGTH=200
# Messages one user may post per window.
CHAT_MESSAGE_LIMIT_PER_USER=5
CHAT_MESSAGE_LIMIT_PER_USER_WINDOW_SECONDS=10
# Messages the chat of one live stream takes per window, from everybody together.
CHAT_ROOM_MESSAGE_LIMIT=20
CHAT_ROOM_MESSAGE_LIMIT_WINDOW_SECONDS=10
# Messages a tab reads when it opens a chat, the newest ones: 1 to 200.
CHAT_BACKLOG_SIZE=100

# --- Live video: a market's live stream -------------------------------------
# Live streams that run at once.
BROADCAST_MAX_LIVE=1
# Requests to go live one user may make per calendar day of APP_TIMEZONE.
BROADCAST_REQUESTS_PER_USER_PER_DAY=3
# Minutes after which a live stream ends by itself.
BROADCAST_MAX_MINUTES=120
# Seconds without a piece from the broadcaster after which a live stream ends by itself.
# At least 10, and above BROADCAST_UPLOAD_BACKLOG_SECONDS.
BROADCAST_STALL_SECONDS=120
# People who watch one live stream at once.
BROADCAST_MAX_VIEWERS=100
# Seconds nginx remembers that the API let a caller watch a live stream: 1 to 60, and
# below BROADCAST_STALL_SECONDS.
BROADCAST_ACCESS_CACHE_SECONDS=5
# Milliseconds of video in one piece the studio sends: 250 to 5000.
BROADCAST_CHUNK_MS=1000
# Bytes of the largest piece. At least twice what one piece holds at the capture rates:
# (BROADCAST_CAPTURE_VIDEO_KBPS + BROADCAST_AUDIO_KBPS) x 125 x BROADCAST_CHUNK_MS / 1000.
BROADCAST_CHUNK_MAX_BYTES=1048576
# Seconds of video a studio queues while its connection is slow. At least 2.
BROADCAST_UPLOAD_BACKLOG_SECONDS=15
# Milliseconds the studio waits for the answer to one piece (at least 1000), and waits
# before it sends a piece again (at least 100).
BROADCAST_UPLOAD_TIMEOUT_MS=10000
BROADCAST_UPLOAD_RETRY_MS=1000
# Milliseconds within which three parts begun pause the studio. At least 1000.
BROADCAST_RESTART_WINDOW_MS=30000
# Milliseconds without a picture after which a player says that it is waiting and asks
# the API. At least 1000.
BROADCAST_WAIT_NOTICE_MS=4000
# Milliseconds after which a player that failed is built again. At least 100.
BROADCAST_PLAYER_RETRY_MS=2000
# kbit/s of video the studio records. At least BROADCAST_VIDEO_KBPS.
BROADCAST_CAPTURE_VIDEO_KBPS=1800
# The largest picture the media box takes from a studio, in pixels. Even numbers:
# a width of 640 to 3840, a height of 360 to 2160.
BROADCAST_INPUT_MAX_WIDTH=1920
BROADCAST_INPUT_MAX_HEIGHT=1080
# The picture people watch: its lines (even, 240 to 1080), its frames per second
# (10 to 30) and its kbit/s (200 to 4000).
BROADCAST_VIDEO_HEIGHT=720
BROADCAST_VIDEO_FPS=24
BROADCAST_VIDEO_KBPS=1200
# kbit/s of sound, recorded and watched: 32 to 192.
BROADCAST_AUDIO_KBPS=64
# Seconds of one segment of the live stream (1 to 6), and segments a playlist names
# (3 to 20).
BROADCAST_HLS_SEGMENT_SECONDS=2
BROADCAST_HLS_PLAYLIST_SEGMENTS=6
# The Unix socket on which the API reaches the media box: an absolute path.
BROADCAST_MEDIA_SOCKET=/run/marketh-media/box.sock
# Milliseconds the API waits for an answer of the media box. At least 100.
BROADCAST_MEDIA_TIMEOUT_MS=2000
# The media box alone: threads of one transcode (1 to 8, at most MEDIA_CPUS rounded up)
# and the preset of its encoder (ultrafast, superfast, veryfast, faster or fast).
MEDIA_FFMPEG_THREADS=2
MEDIA_X264_PRESET=veryfast

# --- Nginx (§9, compose only) -----------------------------------------------
NGINX_CLIENT_MAX_BODY_SIZE=64k
# Per signed-in user; per client address for a request that names nobody.
NGINX_RATE_LIMIT=20r/s
NGINX_RATE_LIMIT_BURST=40
NGINX_SSE_READ_TIMEOUT=3600s
# Event streams one user may hold open at once: one per visible tab. 1 to LIVE_MAX_STREAMS.
NGINX_SSE_STREAMS_PER_CALLER=6
# Pieces of a live stream one user may be sending at once.
NGINX_BROADCAST_UPLOADS_PER_CALLER=2
# Development value: the Next.js dev server needs 'unsafe-eval' and a WebSocket.
NGINX_CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

# --- Local identity (development only) ----------------------------------------
# Nobody signs in on a laptop: the development proxy tells the API who is calling. These
# two name the caller until someone else is picked at /__dev/identity. The name is
# percent-encoded, as the portal sends it. Production passes the portal's headers
# through and reads neither.
DEV_USER_ID=admin@ethz.ch
DEV_USER_NAME=Ada%20Admin

# --- Deployment (Makefile only) ------------------------------------------------
# SSH host (an alias of ~/.ssh/config, or user@host) and the directory on it, relative
# to the home directory, that `make deploy` turns into a mirror of this tree.
DEPLOY_SSH_HOST=viscon-2026
DEPLOY_PATH=marketh

# --- Frontend behaviour (§11), served to the browser by GET /api/config ------
QUOTE_DEBOUNCE_MS=300
# Polling interval when the live stream is unavailable.
LIVE_POLL_FALLBACK_SECONDS=10
# Milliseconds over which the tabs that hear one announcement spread their reads.
# 0: every tab reads at once.
LIVE_ANNOUNCE_SPREAD_MS=1000
# Seconds between two reads of a market by a tab whose viewer holds shares in it, while
# its price moves.
LIVE_VIEWER_REFRESH_SECONDS=5
