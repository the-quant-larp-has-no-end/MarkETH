# MarkETH environment.
#
# Every tunable of the system lives in this file and nowhere else: the backend's Settings
# (backend/app/core/config.py) has no defaults, so a missing variable fails startup.
# Copy this file to `.env` (gitignored). Compose injects it into the containers as real
# environment variables; processes started on the host read the same file.
#
# Conventions
#   - Amounts are in CR (1 CR = 1 voucher = 1 coffee = 1,000,000 µCR). The code converts to µCR.
#   - "§N" refers to docs/SPEC.md. Names used by the spec are kept verbatim.
#   - Lists are comma-separated, no spaces.
#   - *_HOST / *_PORT describe where a process on the host finds a service; the dev stack
#     publishes each store on that port. Inside compose both are overridden with the
#     service name and its standard port (see compose.yaml).

# --- General ---------------------------------------------------------------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Calendar used for monthly grants, issuance caps and proposal limits (§2).
APP_TIMEZONE=Europe/Zurich
# Public origin of the app. Used in magic links and for the Origin check (§3).
PUBLIC_BASE_URL=http://localhost:8080
# Origins allowed on state-changing requests (§3). Must include PUBLIC_BASE_URL.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# --- Published ports (compose only) ----------------------------------------
NGINX_HTTP_PORT=8080
API_HOST_PORT=8000
WEB_HOST_PORT=3000
MAILPIT_UI_PORT=8025

# --- Postgres (§7): the only source of truth -------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketh
# Owner role: runs migrations only.
POSTGRES_USER=marketh_owner
POSTGRES_PASSWORD=marketh_owner_dev
# App role: used by api and relay. Has no UPDATE/DELETE on the ledger tables (§7).
POSTGRES_APP_USER=marketh_app
POSTGRES_APP_PASSWORD=marketh_app_dev
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# --- Redis (§9): limits, cache, sessions, live quotes ----------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Socket timeout. Kept short so a dead Redis never slows a trade down.
REDIS_TIMEOUT_MS=250
# Market list and summaries (§9: 5 seconds).
MARKET_CACHE_TTL_SECONDS=5
# Read-through session cache in front of the sessions table (§3).
SESSION_CACHE_TTL_SECONDS=60
# Comment line sent on idle SSE streams so proxies keep them open.
SSE_HEARTBEAT_SECONDS=15

# --- ScyllaDB (§9): price history ------------------------------------------
SCYLLA_HOSTS=localhost
SCYLLA_PORT=9042
SCYLLA_KEYSPACE=marketh
SCYLLA_REPLICATION_FACTOR=1
SCYLLA_REQUEST_TIMEOUT_MS=1000
# Container resources (compose only).
SCYLLA_SMP=1
SCYLLA_MEMORY=750M
# Outbox relay: rows per batch (§9: up to 100) and idle poll interval.
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=500

# --- Mail (§3): Mailpit locally, real SMTP for the demo ---------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM="MarkETH <no-reply@vis.ethz.ch>"

# --- Authentication and eligibility (§3) -----------------------------------
ALLOWED_EMAIL_DOMAINS=student.ethz.ch,ethz.ch
# All allowed domains collapse onto this one for the canonical identity.
CANONICAL_EMAIL_DOMAIN=ethz.ch
# Roles are assigned at sign-in from these lists (canonical or alias addresses).
ADMIN_EMAILS=admin@ethz.ch
BARISTA_EMAILS=barista@ethz.ch
LOGIN_TOKEN_BYTES=32
LOGIN_TOKEN_TTL_MINUTES=15
# Rate limits: <count> per <window>. Login endpoints fail closed if Redis is down.
LOGIN_LINK_LIMIT_PER_EMAIL=3
LOGIN_LINK_LIMIT_PER_EMAIL_WINDOW_SECONDS=900
LOGIN_LINK_LIMIT_PER_IP=20
LOGIN_LINK_LIMIT_PER_IP_WINDOW_SECONDS=3600
LOGIN_VERIFY_LIMIT_PER_IP=10
LOGIN_VERIFY_LIMIT_PER_IP_WINDOW_SECONDS=60
SESSION_COOKIE_NAME=marketh_session
# Must be true whenever the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30
SESSION_IDLE_TTL_DAYS=7
# How often last_seen_at is written back to Postgres.
SESSION_TOUCH_INTERVAL_SECONDS=300

# --- Vouchers, codes and coffee tickets (§2) --------------------------------
SIGNUP_GRANT_CR=5
MONTHLY_GRANT_CR=1
VOUCHER_CODE_MIN_VALUE_CR=1
VOUCHER_CODE_MAX_VALUE_CR=5
VOUCHER_CODE_DEFAULT_VALUE_CR=1
# Characters of Crockford Base32 (12 = 60 bits).
VOUCHER_CODE_LENGTH=12
# CR of code value VIS may issue per calendar month.
MAX_CODE_ISSUANCE_PER_MONTH=200
# Redemption fails closed (503) if Redis is down.
CODE_REDEEM_LIMIT_PER_USER=5
CODE_REDEEM_LIMIT_PER_USER_WINDOW_SECONDS=600
CODE_REDEEM_LIMIT_PER_IP=20
CODE_REDEEM_LIMIT_PER_IP_WINDOW_SECONDS=3600
COFFEE_TICKET_VALUE_CR=1
COFFEE_TICKET_CODE_LENGTH=8
COFFEE_TICKET_EXPIRY_DAYS=30

# --- LMSR pricing and trading (§4) ------------------------------------------
# Liquidity parameter b per tier, in CR. Worst-case loss per market is b * ln 2.
LMSR_TIER_TIGHT_B=5
LMSR_TIER_DEFAULT_B=10
LMSR_TIER_MEDIUM_B=20
PRICING_DECIMAL_PRECISION=50
# CR a user may have at stake per market.
MAX_STAKE_PER_USER_MARKET=1
MIN_TRADE_CR=0.01
MIN_TRADE_SHARES=0.01
# Buy buttons offered on the trade sheet.
TRADE_STAKE_PRESETS_CR=0.25,0.5,1
# Decimals of a displayed percentage (1 = 0.1 percentage points).
PRICE_DISPLAY_DECIMALS=1

# --- Risk controls (§5) -----------------------------------------------------
MAX_OPEN_MARKETS=100
# CR. b is derived from the budget: b = budget / ln 2.
MAX_MARKET_BUDGET=1000
# CR. Sum of b * ln 2 over OPEN and HALTED markets.
MAX_AGGREGATE_LOSS_BUDGET=700
# Trades per user per minute.
MAX_ORDERS_PER_MINUTE=10
# Days between approval and close_at.
MAX_MARKET_LIFETIME=90
# The admin risk page raises an alert above this many CR of outstanding obligations.
OBLIGATIONS_ALERT_THRESHOLD_CR=1000

# --- Market lifecycle (§6) --------------------------------------------------
MAX_PROPOSALS_PER_USER_PER_DAY=3
# resolve_by may be at most this many days after close_at.
MAX_RESOLUTION_DELAY_DAYS=14

# --- Nginx (§9, compose only) -----------------------------------------------
NGINX_CLIENT_MAX_BODY_SIZE=64k
NGINX_RATE_LIMIT=20r/s
NGINX_RATE_LIMIT_BURST=40
NGINX_SSE_READ_TIMEOUT=3600s
# Development value. For production drop 'unsafe-eval' and the ws: sources.
NGINX_CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; media-src 'self' blob:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

# --- Frontend behaviour (§11), served to the browser by GET /api/config ------
QUOTE_DEBOUNCE_MS=300
# Polling interval when the live stream is unavailable.
LIVE_POLL_FALLBACK_SECONDS=10
